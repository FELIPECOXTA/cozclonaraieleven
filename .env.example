# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ELEVENLABS_API_KEY: Optional - For 100% identical ElevenLabs neural voice cloning, speech synthesis, and sound effects.
# If not provided here, users can enter it directly in the app UI.
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY"

# Gateway de transcrição: configure APENAS no servidor (nunca em VITE_).
# Requer Supabase Auth com JWT assimétrico + Redis privado para cache e cotas por conta.
SUPABASE_URL=""
REDIS_URL=""
TRANSCRIPTION_CACHE_SECRET=""
# Configure ELEVENLABS_API_KEY no secrets manager do host. NÃO use valores reais aqui.
# Dados PÚBLICOS do Supabase usados somente para autenticação do navegador.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Provedores de transcrição, em ordem. Todos os segredos ficam NO SERVIDOR.
# 1: ElevenLabs Scribe (prazo de espera 7 segundos).
ELEVENLABS_STT_MODEL="scribe_v2"
# 2: Gemini Transcribe (prazo de espera 7 segundos).
GEMINI_STT_MODEL="gemini-3.5-transcribe"
# 3: OpenAI Speech-to-Text (prazo de espera 12 segundos), OPCIONAL.
# O ChatGPT Plus e o Gemini Pro não garantem cotas de API pagas.
OPENAI_API_KEY=""
# A fila de transcrição precisa de Redis persistente, privado, com TLS.
# REDIS_URL e TRANSCRIPTION_CACHE_SECRET já aparecem acima.
